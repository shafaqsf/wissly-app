# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase -----------------------------------------------------------
# Project Settings -> API Keys.
#
# The publishable key reaches the browser. That is not the same as it being
# harmless: it grants the `anon` role, and the only thing standing between it
# and the data is row level security. A table in an exposed schema without
# `enable row level security` and a matching policy is world-readable to
# anyone who opens devtools. Enable RLS on every table, then write a policy
# that reflects the actual access model — see migrations/README.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Bypasses row level security entirely, so a policy mistake is
# not caught here — never prefix with NEXT_PUBLIC_, never import into a
# client component.
SUPABASE_SECRET_KEY=

# The legacy JWT keys (`anon`, `service_role`) still work and map to the two
# above. New projects should use the sb_publishable_ / sb_secret_ keys.

# There is no database connection string here on purpose. Migrations are
# applied by hand in the dashboard SQL editor — see migrations/README.md. A
# direct connection would carry the database password and the right to
# disable row level security, which is more than any part of this app needs.

# --- OpenRouter ---------------------------------------------------------
# https://openrouter.ai/keys — server only.
OPENROUTER_API_KEY=

# Default model for agent runs. Overridable per request.
# Cheaper alternative for high-volume routes: anthropic/claude-sonnet-5
OPENROUTER_MODEL=anthropic/claude-opus-5

# Sent as HTTP-Referer / X-Title so usage shows up attributed on OpenRouter.
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=wissly

# Used for the two ingestion paths that read an image: transcribing a photo
# of handwritten or printed notes, and explaining a diagram on an
# image-heavy PDF page. Optional — falls back to OPENROUTER_MODEL, but the
# three curated chat models are not guaranteed to be vision-capable, so set
# this to one that is if you want either feature to work.
OPENROUTER_VISION_MODEL=
