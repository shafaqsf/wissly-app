# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase -----------------------------------------------------------
# Project Settings -> API. The anon key is safe to expose to the browser;
# row level security is what actually protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Bypasses row level security — never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection, used by the migration runner only.
# Project Settings -> Database -> Connection string (URI).
SUPABASE_DB_URL=

# --- OpenRouter ---------------------------------------------------------
# https://openrouter.ai/keys — server only.
OPENROUTER_API_KEY=

# Default model for agent runs. Overridable per request.
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Sent as HTTP-Referer / X-Title so usage shows up attributed on OpenRouter.
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=wissly
