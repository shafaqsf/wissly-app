# Normalize line endings: LF in the repository, native in the working copy.
* text=auto eol=lf

# SQL migrations are applied verbatim — keep them LF everywhere.
migrations/*.sql text eol=lf

# Binary assets must never be normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary

# Generated — collapse in pull request diffs.
package-lock.json linguist-generated=true -diff
